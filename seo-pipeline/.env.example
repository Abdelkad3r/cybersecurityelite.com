# ─── CTF writeup pipeline — configuration ──────────────────────────────────
# Copy to .env (or seo-pipeline/.env) and fill in. Never commit .env.

# Required: OpenAI API key for the LLM call.
#   - Get a key: https://platform.openai.com/api-keys
#   - Use a *project key* (sk-proj-...) so you can scope and revoke per pipeline.
#   - NEVER paste this key into chat / Slack / commits. It only lives in .env.
OPENAI_API_KEY=sk-proj-...

# Model.
#   - gpt-4o      — balanced, recommended default for technical-writing JSON output.
#   - gpt-4o-mini — ~10× cheaper, weaker on long-form structure. Useful for batch runs.
#   - gpt-4.1     — if available in your account, slightly better at JSON adherence.
OPENAI_MODEL=gpt-4o

# Hard cap on output tokens. 12k is enough for a ~9k-word article + the
# cover-field JSON. Raise to 16k only if your articles consistently get
# truncated mid-FAQ.
OPENAI_MAX_TOKENS=12000

# Hugo project root. Defaults to the parent of the pipeline directory.
SITE_ROOT=/Users/apple/cybersecurityelite

# Default author for the front-matter — must match a file under data/authors.yaml.
DEFAULT_AUTHOR=CyberSecurity Elite Team

# Git settings — only used when invoked with --publish.
GIT_BRANCH=main
GIT_COMMIT_AUTHOR_NAME=Article Pipeline
GIT_COMMIT_AUTHOR_EMAIL=article-pipeline@cybersecurityelite.com

# Logging. Standard Python levels: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
