# =============================================================================
# CyberSecurity Elite — SEO Automation Pipeline configuration
# Copy to .env and fill in. Never commit .env to git.
# =============================================================================

# --- LLM provider -------------------------------------------------------------
# Which provider to use for article generation: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=8000

# OpenAI (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=8000

# --- Site / content -----------------------------------------------------------
# Absolute path to the Hugo project root (where hugo.toml lives).
SITE_ROOT=/Users/apple/cybersecurityelite

# Default Hugo section new articles land in. Must exist under content/.
# Allowed: tutorials, ctf-writeups, tools, posts, news, certifications,
#          malware-analysis, reverse-engineering, forensics, bug-bounty,
#          cloud-security, web-security, network-security, career
DEFAULT_SECTION=tutorials

# Default author key (must match a file under data/authors.yaml).
DEFAULT_AUTHOR=CyberSecurity Elite Team

# Target word count per article (the model is given this as guidance).
TARGET_WORD_COUNT_MIN=1800
TARGET_WORD_COUNT_MAX=3500

# --- Keyword generator --------------------------------------------------------
# Comma-separated seeds. The pipeline expands these via Google Autocomplete +
# People-Also-Ask, then filters to informational/long-tail intent.
SEED_KEYWORDS=active directory security,windows hardening,linux privilege escalation,siem detection,ctf walkthrough,malware analysis,bug bounty,kubernetes security

# Per-run caps (keep costs bounded).
MAX_KEYWORDS_PER_RUN=20
MAX_ARTICLES_PER_RUN=3

# Locale/region for Google Autocomplete (hl=language, gl=country).
AUTOCOMPLETE_HL=en
AUTOCOMPLETE_GL=us

# --- Publishing ---------------------------------------------------------------
# When PUBLISH_MODE=draft (default), generated articles get `draft: true` so
# they appear in your review queue but are not built/served. When PUBLISH_MODE=
# publish, articles are written with draft:false AND auto-committed/pushed.
#
# Why draft is the default: Google's helpful-content system penalises sites
# that publish unreviewed AI content at scale. Default-draft gives you a
# human-in-the-loop checkpoint without slowing the keyword pipeline down.
PUBLISH_MODE=draft

# Git auto-publish settings (only consulted when PUBLISH_MODE=publish).
GIT_BRANCH=main
GIT_REMOTE=origin
GIT_COMMIT_AUTHOR_NAME=SEO Pipeline
GIT_COMMIT_AUTHOR_EMAIL=seo-pipeline@cybersecurityelite.com

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
# Set to 1 to dry-run (no files written, no git ops, no API calls billed for
# article generation — keyword discovery still runs).
DRY_RUN=0
