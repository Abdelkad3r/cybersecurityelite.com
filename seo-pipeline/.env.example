# ─── CTF writeup pipeline — configuration ──────────────────────────────────
# Copy to .env (or seo-pipeline/.env) and fill in. Never commit .env.

# Required: Anthropic API key for the LLM call.
ANTHROPIC_API_KEY=sk-ant-...

# Model. claude-opus-4-7 has the 1M-context variant we need for multi-README
# prompts; claude-sonnet-4-6 works too and is cheaper for single-category runs.
ANTHROPIC_MODEL=claude-opus-4-7

# Hard cap on output tokens. 16k fits a 7,000-word article + cover JSON
# with room to spare.
ANTHROPIC_MAX_TOKENS=16000

# Hugo project root. Defaults to the parent of the pipeline directory.
SITE_ROOT=/Users/apple/cybersecurityelite

# Default author for the front-matter — must match a file under data/authors.yaml.
DEFAULT_AUTHOR=CyberSecurity Elite Team

# Git settings — only used when invoked with --publish.
GIT_BRANCH=main
GIT_COMMIT_AUTHOR_NAME=CTF Writeup Pipeline
GIT_COMMIT_AUTHOR_EMAIL=ctf-pipeline@cybersecurityelite.com

# Logging. Standard Python levels: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Set to 1 to walk every step but skip the LLM call (useful for smoke-testing
# the gh fetch + prompt rendering after pulling a new repo).
DRY_RUN=0
