{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- /* Filter out term pages under /tags/ — they're noindex,follow at the page
       level, so listing them in the sitemap just wastes Google's discovery
       budget on URLs it can't index. Categories, series, and author terms
       are kept since those taxonomies have fewer, denser pages. */ -}}
{{ range .Data.Pages }}
  {{- $skip := false -}}
  {{- if and (eq .Kind "term") (eq .Section "tags") -}}{{ $skip = true }}{{- end -}}
  {{- if not $skip -}}
  {{- if .Permalink -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
  {{- end -}}
  {{- end -}}
{{ end }}
</urlset>
